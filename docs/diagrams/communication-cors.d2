# 前后端通信与 CORS 架构图
# D2 渲染: d2 communication-cors.d2 communication-cors.svg
# 说明：前端通过两种协议与后端通信（REST/JSON + SSE），
#       跨域在开发环境用 Vite 反代、生产环境用 CORSMiddleware 解决。

direction: right

# ── 客户端层 ─────────────────────────────────────
client: 浏览器前端\nVue 3 + Vite SPA {
  style.fill: "#e3f2fd"
  style.stroke: "#1976d2"
  style.stroke-width: 2
  style.bold: true
  style.font-color: "#0d47a1"
  axios: axios 实例\nREST / JSON\n(baseURL=/api, Bearer JWT)
  sse: fetchStream + SSEParser\nSSE 流式 + 断点续传
}

# ── 跨域方案层 ───────────────────────────────────
cors_layer: 跨域方案 (CORS) {
  style.fill: "#fff3e0"
  style.stroke: "#f57c00"
  style.stroke-width: 2
  style.bold: true
  style.font-color: "#e65100"
  dev: Vite 开发代理\n/api → :8000 (changeOrigin)\n【开发环境 · 同源，不触发 CORS】
  prod: Nginx 反代 + CORSMiddleware\n【生产环境 · CORS 白名单】
}

# ── 后端层 ───────────────────────────────────────
backend: FastAPI 后端 (Python) {
  style.fill: "#e8f5e9"
  style.stroke: "#388e3c"
  style.stroke-width: 2
  style.bold: true
  style.font-color: "#1b5e20"
  cors: CORSMiddleware\nallow_origins / credentials\n放行 X-Stream-Id, Last-Event-ID
  rest_rt: REST 路由控制器\nuser / trip / conversation /\nfeedback / history / stats ...
  sse_rt: SSE 端点\nStreamingResponse\nmedia_type=text/event-stream
}

# ── 数据 / 外部服务层 ────────────────────────────
data: 数据与外部服务 {
  style.fill: "#f3e5f5"
  style.stroke: "#7b1fa2"
  style.stroke-width: 2
  style.bold: true
  style.font-color: "#4a148c"
  mysql: MySQL 8 {shape: cylinder}
  redis: Redis 7\nstreamStore / 续传 / 限流 {shape: cylinder}
  chroma: Chroma 向量库 {shape: cylinder}
  llm: DeepSeek\n(deepseek-chat) {shape: cloud}
}

# ── 连接关系 ─────────────────────────────────────
client.axios -> cors_layer.dev: 开发期 /api {style.stroke:"#1976d2"; style.stroke-width:2; style.bold:true}
client.sse   -> cors_layer.dev: 开发期 SSE
client.axios -> cors_layer.prod: 生产 HTTPS /api {style.stroke:"#1976d2"; style.stroke-width:2; style.bold:true}
client.sse   -> cors_layer.prod: 生产 SSE

cors_layer.dev  -> backend.cors: 同源转发 {style.stroke:"#388e3c"; style.stroke-width:2}
cors_layer.prod -> backend.cors: 跨域头校验 {style.stroke:"#f57c00"; style.stroke-width:2; style.bold:true}

backend.cors -> backend.rest_rt: 普通请求
backend.cors -> backend.sse_rt: 流式请求
backend      -> data.mysql:  ORM
backend      -> data.redis:  streamStore
backend      -> data.chroma: 向量检索
backend      -> data.llm:  对话补全
