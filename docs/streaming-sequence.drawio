0;" vertex="1" parent="1"><mxGeometry x="608" y="494.0" width="280" height="36" as="geometry"/></mxCell><mxCell id="e9" value="fetchOnce() 发起流式请求" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="118.0" y="98" as="sourcePoint"/><mxPoint x="320.0" y="98" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e10" value="HTTP 429 (Retry-After)" style="endArrow=open;html=1;rounded=0;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320.0" y="144" as="sourcePoint"/><mxPoint x="118.0" y="144" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e11" value="delay(Retry-After/退避); attempt++; onResume" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative='1' as='geometry'><Array as='points'><mxPoint x="178.0" y="190" as="point"/><mxPoint x="178.0" y="215.3" as="point"/></Array></mxGeometry></mxCell><mxCell id="e12" value="递归 run() 重连 (不需 streamId)" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="118.0" y="236" as="sourcePoint"/><mxPoint x="320.0" y="236" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e13" value="HTTP 500/502/503/504" style="endArrow=open;html=1;rounded=0;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320.0" y="282" as="sourcePoint"/><mxPoint x="118.0" y="282" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e14" value="delay(退避); attempt++; onResume; run()" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative='1' as='geometry'><Array as='points'><mxPoint x="178.0" y="328" as="point"/><mxPoint x="178.0" y="353.3" as="point"/></Array></mxGeometry></mxCell><mxCell id="e15" value="其他 4xx (如 401) UpstreamError" style="endArrow=open;html=1;rounded=0;dashed=1;strokeColor=#999999;" edge="1" paren