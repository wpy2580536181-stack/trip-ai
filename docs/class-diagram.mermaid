%% Trip Python 后端 — 类图
%% 核心数据模型 + 服务类 + 关系

classDiagram
    direction TB

    %% ═══════════════════════════════════════
    %% 数据模型层（SQLAlchemy Models）
    %% ═══════════════════════════════════════

    class RoleName {
        <<enumeration>>
        ADMIN
        USER
    }

    class Role {
        +int id
        +RoleName name
        +datetime created_at
        +list~User~ users
    }

    class User {
        +int id
        +str username
        +str email
        +str password
        +str? nickname
        +str? avatar
        +str? phone
        +str? bio
        +int role_id
        +int status
        +dict? preferences
        +datetime created_at
        +datetime updated_at
        +Role role
        +list~Trip~ trips
        +list~Conversation~ conversations
        +list~Feedback~ feedbacks
    }

    class PasswordReset {
        +int id
        +str email
        +str token
        +datetime expires_at
        +bool used
        +datetime created_at
    }

    class Trip {
        +int id
        +int? user_id
        +str? from_city
        +str city
        +int days
        +int budget
        +dict content
        +str status
        +int? parent_trip_id
        +datetime created_at
        +User? user
        +Trip? parent
        +list~Trip~ versions
    }

    class Conversation {
        +int id
        +int user_id
        +str? title
        +str? summary
        +str? recap
        +bool? summary_error
        +datetime? summary_at
        +datetime created_at
        +datetime updated_at
        +User user
        +list~Message~ messages
    }

    class Message {
        +int id
        +int conversation_id
        +str role
        +str content
        +dict? metadata
        +bool? excluded_from_context
        +datetime created_at
        +Conversation conversation
        +list~Feedback~ feedbacks
        +list~AgentStep~ steps
    }

    class Spot {
        +int id
        +str name
        +str city
        +str category
        +str description
        +dict tags
        +float? avg_cost
        +str? duration
        +str? open_time
        +float? rating
        +str? vector_id
        +datetime created_at
        +datetime updated_at
    }

    class Feedback {
        +int id
        +int user_id
        +int message_id
        +int conversation_id
        +int rating
        +str? comment
        +dict? tags
        +datetime created_at
        +datetime updated_at
        +User user
        +Message message
    }

    class AgentStep {
        +int id
        +int message_id
        +int step
        +str type
        +str? name
        +dict? args
        +str? output
        +int? duration_ms
        +str? error
        +datetime created_at
        +Message message
    }

    %% ═══════════════════════════════════════
    %% 服务层
    %% ═══════════════════════════════════════

    class UserService {
        +register(username, email, password) dict
        +login(username, password) dict
        +get_user_info(user_id) dict
        +update_user_info(user_id, data) dict
        +change_password(user_id, old, new) dict
        +create_password_reset_token(email) dict
        +reset_password(email, token, new) dict
        -hash_password(password) str
        -verify_password(password, hash) bool
    }

    class TripService {
        +recommend(city, budget, days, user_id, departure_city?) dict
        +chat_stream(user_id, message, conversation_id?, callbacks) dict
        -persist_assistant(msg_id, content, force, usage?) void
    }

    class ConversationService {
        +get_or_create_conversation(user_id, conversation_id?) Conversation
        +save_message(conv_id, role, content, metadata?) Message
        +list_conversations(user_id, page, page_size) dict
        +get_conversation_detail(conv_id, user_id) Conversation?
        +delete_conversation(conv_id, user_id) void
        +load_context(conv_id) dict
        +update_summary(conv_id, summary) void
        +auto_title(conv_id, first_message) void
    }

    class KnowledgeService {
        +search_spots(query, city, category?, limit?) str
        +create_spot(input) Spot
        +update_spot(id, input) Spot
        +delete_spot(id) void
        +list_spots(city?, category?, page, page_size) dict
        -mysql_keyword_search(city, keywords, category?, limit) list
        -mysql_rating_search(city, category?, limit) list
    }

    class AgentEngine {
        -ChatOpenAI llm
        -ToolCache tool_cache
        -list amap_tools
        +chat(user_id, message, conversation_id?, message_id, on_event, signal?) dict
        +recommend(user_id, city, budget, days, departure_city?, on_event) dict
        +ensure_amap_tools() void
        -build_agent(llm, system_prompt) AgentExecutor
        -load_user_preferences(user_id) dict?
        -db_messages_to_langchain(messages) list
    }

    class ChatGraph {
        +build_chat_graph() CompiledGraph
    }

    class PlannerGraph {
        +build_planner_graph() CompiledGraph
    }

    class RAGEngine {
        +search_spots(query, city, category?, limit?) str
        -chroma_search(query, city, category?) list
        -mysql_keyword_search(city, keywords, category?, limit) list
        -mysql_rating_search(city, category?, limit) list
        -rrf_fuse(path1, path2, path3) list
    }

    class QueryRewriter {
        +rewrite_query(query, city?) str
        -extract_keywords(query, city) list
    }

    class Reranker {
        +rerank(query, documents) list
        +rerank_top_k(query, documents, k) list
        -get_reranker() CrossEncoder
    }

    class StreamManager {
        +create_resumable_stream(user_id, conversation_id) StreamingResponse
        +resume_stream(stream_id, last_seq, user_id) StreamingResponse
    }

    class StreamStore {
        +create_stream(user_id, conversation_id) str
        +append_event(stream_id, event) int
        +get_events_since(stream_id, last_seq) list
        +get_stream_state(stream_id) dict
        +mark_complete(stream_id) void
        +delete_stream(stream_id) void
    }

    class TraceRecorder {
        -int message_id
        -list steps
        +add(step) void
        +flush(session) void
    }

    class TokenBudgetManager {
        +check_user_budget(user_id) dict
        +check_global_budget() dict
        +record_user_usage(user_id, tokens) void
        +record_global_usage(tokens) void
        +get_global_stats() dict
        +get_user_stats(user_id) dict
    }

    class ConcurrencyGuard {
        +try_acquire(user_id) tuple
        -Semaphore global_sem
        -dict per_user_sems
    }

    class ToolCache {
        +get_or_compute(tool_name, args, compute) tuple
        -literal_lookup(tool_name, args, compute, cache, cfg) tuple
        -embedding_lookup(tool_name, args, compute, cache, cfg) tuple
        -make_literal_key(tool_name, args) str
    }

    class AmapMcpClient {
        +connect() void
        +list_tools() list
        +call_tool(name, args) str
        +close() void
        -send_request(method, params?) any
        -handle_response(line) void
    }

    class AmapGuards {
        +call(tool_name, args, cache_ttl?) str
        +get_metrics() dict
        +reset_circuit() void
        +clear_cache() void
    }

    class TokenMonitor {
        +record(metrics) void
        +get_recent(limit) list
        +aggregate(request_type?, user_id?) dict
    }

    %% ═══════════════════════════════════════
    %% 关系定义
    %% ═══════════════════════════════════════

    %% 数据模型关系
    Role ||--o{ User : "users"
    User ||--o{ Trip : "trips"
    User ||--o{ Conversation : "conversations"
    User ||--o{ Feedback : "feedbacks"
    Conversation ||--o{ Message : "messages (cascade)"
    Message ||--o{ Feedback : "feedbacks (cascade)"
    Message ||--o{ AgentStep : "steps (cascade)"
    Trip ||--o{ Trip : "versions (self-ref)"

    %% 服务依赖关系
    TripService --> AgentEngine : "chat/recommend"
    TripService --> ConversationService : "get_or_create/save"
    AgentEngine --> ChatGraph : "chat"
    AgentEngine --> PlannerGraph : "recommend"
    AgentEngine --> TraceRecorder : "trace"
    AgentEngine --> TokenMonitor : "monitor"
    AgentEngine --> ToolCache : "cache"
    AgentEngine --> ConcurrencyGuard : "concurrency"

    ChatGraph --> RAGEngine : "research node"
    PlannerGraph --> RAGEngine : "research node"
    RAGEngine --> QueryRewriter : "rewrite"
    RAGEngine --> Reranker : "rerank"

    TripService --> StreamManager : "SSE stream"
    StreamManager --> StreamStore : "Redis double-write"

    KnowledgeService --> RAGEngine : "search_spots"

    AmapGuards --> AmapMcpClient : "call_tool"
    AmapGuards --> ConcurrencyGuard : "rate limit"

    %% ═══════════════════════════════════════
    %% 注释
    %% ═══════════════════════════════════════
    note for User "preferences: JSON (dict)\npassword: bcrypt $2b$ 格式\nrole_id: 1=admin, 2=user"
    note for Message "onDelete: Cascade (from Conversation)\nmetadata: JSON (含 LLM usage)"
    note for StreamStore "Redis 三 key 设计:\nHASH stream:uuid (状态)\nLIST stream:uuid:events\nSTRING stream:uuid:seq (INCR)"
    note for AgentEngine "单例模式\n管理 LLM、工具缓存、MCP tools"
    note for ToolCache "retrieve_knowledge: embedding 归一化\n其他: 字面归一化\n阈值: cosine ≥ 0.85"
